		"zpos"			    "1"
		"wide"			    "24"
		"tall"			    "24"
		"autoResize"		"0"
		"pinCorner"		    "0"
		"visible"		    "1"
		"enabled"		    "1"
		"wrap"			    "0"
		"labelText"		    "%capturetime%"
		"textAlignment"		"center"
		"fgcolor"		    "NootWhite"
	}
}
